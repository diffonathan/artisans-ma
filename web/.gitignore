# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ... sauf l'exemple, qui est le seul fichier d'environnement à VERSIONNER :
# c'est lui qui documente les variables attendues. Sans cette exception,
# `.env*` l'emporte et quelqu'un qui clone le dépôt n'a aucun moyen de savoir
# ce qu'il doit renseigner.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
