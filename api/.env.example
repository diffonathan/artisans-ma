# Copier en `.env` et adapter. Toutes les valeurs ci-dessous sont les valeurs
# par défaut : le projet démarre sans fichier .env, avec le docker-compose.

# ── Base de données ─────────────────────────────────────────────────────────
# `directConnection=true` n'est pas optionnel depuis l'hôte : le replica set
# s'annonce sur `localhost:27017` (vu de l'intérieur du conteneur) alors que le
# port est publié sur 27018. Sans ce paramètre, le pilote découvre la topologie
# et tente de se connecter à une adresse qui ne répond pas.
MONGO_URI=mongodb://localhost:27018/artisans?directConnection=true

REDIS_URI=redis://localhost:6380

# ── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Commission de la place de marché, en points de base. 800 = 8,00 %.
# Elle est FIGÉE sur chaque réservation au moment de l'acceptation : changer
# cette valeur ne réécrit pas les réservations passées.
COMMISSION_POINTS_DE_BASE=800

# ── Sécurité ────────────────────────────────────────────────────────────────
# À remplacer par une valeur tirée au hasard. Il n'y a pas de valeur par
# défaut partagée : un secret identique dans tous les dépôts du monde est pire
# qu'un secret absent, parce qu'il donne l'impression d'être protégé.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Coût de scrypt, en logarithme base 2. 16 = 2^16, environ 220 ms par mot de
# passe : c'est le bon prix en production.
#
# Les tests l'abaissent à 12 (~15 ms), ce qui est sûr parce que l'empreinte
# porte ses propres paramètres et se vérifie sous n'importe quel réglage.
# Accepté entre 12 et 20 ; toute autre valeur revient au défaut plutôt que
# d'affaiblir les mots de passe en silence.
SCRYPT_COUT_LOG2=16
